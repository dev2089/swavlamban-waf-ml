# Non-secret runtime configuration
WAF_ENV=development
WAF_PIPELINE_VERSION=phase3
WAF_FEATURE_SCHEMA=http-v2
WAF_STORAGE_BACKEND=memory
WAF_STORAGE_URL=state/runtime_events.db
WAF_AUTH_REQUIRED=false
WAF_RETENTION_DAYS=30
WAF_UPSTREAM_URL=http://127.0.0.1:9000
WAF_LISTEN_HOST=127.0.0.1
WAF_LISTEN_PORT=8080
WAF_REQUEST_TIMEOUT_SECONDS=10
WAF_MAX_BODY_BYTES=1048576
WAF_MAX_RESPONSE_BYTES=10485760

# Secrets: inject through the runtime secret manager/environment. Never commit values.
# WAF_AUTH_SECRET=<runtime secret, >=32 bytes>
# FLASK_SECRET_KEY=<runtime secret, >=32 bytes>
# SUPABASE_URL=<project URL>
# SUPABASE_SERVICE_ROLE_KEY=<runtime secret, >=32 bytes>
# SUPABASE_ANON_KEY=<public client key only where a browser client explicitly needs it>
