# Supabase public client configuration (safe only for browser-side use)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_public_anon_key

# Backend server configuration
WAF_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
WAF_AUTH_SECRET=replace_with_random_32_byte_minimum_secret
WAF_CORS_ORIGINS=http://localhost:3000
WAF_TOKEN_ISSUER=swavlamban-waf
WAF_TOKEN_AUDIENCE=waf-control-plane
WAF_TOKEN_TTL_SECONDS=900
WAF_CLOCK_SKEW_SECONDS=30
API_HOST=0.0.0.0
API_PORT=8000

# ML configuration
ML_MODEL_PATH=./models
LOG_LEVEL=INFO
